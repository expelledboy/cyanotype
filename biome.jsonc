{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "tests/**"] },

  // Formatting is NOT enforced. Route maps, event catalogs and binding literals
  // in this codebase are column-aligned by hand so the shape of a contract is
  // readable at a glance; a formatter collapses that alignment and the
  // readability it buys is worth more than machine-checked whitespace.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // tsconfig sets `noUncheckedIndexedAccess`, so every index access is
        // `T | undefined`. `arr[0]!` is the deliberate escape hatch that makes
        // that setting usable in tests where the element is provably present.
        // Banning it would mean either dropping the stricter tsconfig or
        // wrapping known-good indexing in noise.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // A test harness reports through the console by design: `reporter.ts`
        // exists to print, and the orchestrator's detached log tasks have
        // nowhere else to surface a failure.
        "noConsole": "off"
      }
    }
  }
}

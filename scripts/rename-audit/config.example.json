{
  "campaign": "speculum→cyanotype",
  "baselinePath": ".rename-audit/baseline.json",
  "exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.speculum-env/**",
    "**/.cyanotype-env/**",
    "**/.orient/**",
    "**/working/**",
    "**/.direnv/**",
    "**/.cache/**",
    "**/.DS_Store",
    "**/*.{png,jpg,jpeg,gif,webp,ico,woff,woff2,ttf,eot,zip,gz,tgz,tar,br,wasm,mp4,pdf}",
    "**/.rename-audit/**",
    "scripts/rename-audit/**"
  ],
  "roots": [
    { "id": "library", "path": ".", "zone": "library", "role": "required" },
    { "id": "brt", "path": "${PAYSWITCH_BRT_TESTS}", "zone": "consumer", "role": "required" },
    { "id": "crimson-deploy", "path": "${CRIMSON_DEPLOY}", "zone": "infra", "role": "required" },
    { "id": "crimson-deploy-brt-slice", "path": "${CRIMSON_DEPLOY_BRT_SLICE}", "zone": "infra", "role": "hygiene" },
    { "id": "crimson-deploy-brt-helm", "path": "${CRIMSON_DEPLOY_BRT_HELM}", "zone": "infra", "role": "hygiene" },
    { "id": "crimson-deploy-brt-trigger", "path": "${CRIMSON_DEPLOY_BRT_TRIGGER}", "zone": "infra", "role": "hygiene" },
    { "id": "crimson-deploy-run-brt", "path": "${CRIMSON_DEPLOY_RUN_BRT}", "zone": "infra", "role": "hygiene" },
    { "id": "crimson-deploy-run-brt-eks", "path": "${CRIMSON_DEPLOY_RUN_BRT_EKS}", "zone": "infra", "role": "hygiene" },
    { "id": "crimson-deploy-run-brt-npm", "path": "${CRIMSON_DEPLOY_RUN_BRT_NPM}", "zone": "infra", "role": "hygiene" },
    { "id": "bl-simulator", "path": "${PAYSWITCH_BL_SIMULATOR}", "zone": "simulator", "role": "required" },
    { "id": "network-simulator", "path": "${PAYSWITCH_NETWORK_SIMULATOR}", "zone": "simulator", "role": "required" }
  ]
}

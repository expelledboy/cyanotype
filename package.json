{
  "name": "@expelledboy/cyanotype",
  "version": "0.6.0",
  "description": "Bun-native blackbox test harness built around the Component Blueprint",
  "license": "MIT",
  "author": "Anthony Jackson <102334+expelledboy@users.noreply.github.com>",
  "homepage": "https://github.com/expelledboy/cyanotype#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expelledboy/cyanotype.git"
  },
  "bugs": {
    "url": "https://github.com/expelledboy/cyanotype/issues"
  },
  "keywords": [
    "bun",
    "testing",
    "integration-testing",
    "blackbox",
    "docker",
    "kubernetes",
    "testcontainers",
    "harness",
    "blueprint"
  ],
  "type": "module",
  "bin": {
    "cyanotype": "./dist/cli/index.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests/core/ tests/substrate/",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build && bun test tests/core/ tests/substrate/"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "dockerode": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.3.14",
    "typescript": "^5.5.0"
  }
}
